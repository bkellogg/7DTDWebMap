<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
            Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{7D2D0F1E-5A3B-4C6D-9E8F-0A1B2C3D4E71}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>WebMap</RootNamespace>
        <AssemblyName>WebMap</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <LangVersion>7.3</LangVersion>
        <FileAlignment>512</FileAlignment>
        <GamePath>C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</GamePath>
        <ModName>WebMap</ModName>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="mscorlib">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\mscorlib.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="LogLibrary">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\LogLibrary.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="SpaceWizards_HttpListener">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\SpaceWizards_HttpListener.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(GamePath)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System.Xml">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\System.Xml.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System.Xml.Linq">
            <HintPath>$(GamePath)\7DaysToDie_Data\Managed\System.Xml.Linq.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System"/>
        <Reference Include="System.Core"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Properties\AssemblyInfo.cs"/>
        <Compile Include="WebMapMod.cs"/>
        <Compile Include="ConsoleCmdWebMap.cs"/>
        <Compile Include="Companion.cs"/>
        <Compile Include="MapPatches.cs"/>
        <Compile Include="NavMirror.cs"/>
        <Compile Include="WebHost.cs"/>
        <Compile Include="CompanionSettings.cs"/>
        <Compile Include="XUiC_CompanionPanel.cs"/>
        <Compile Include="WorkstationTracker.cs"/>
        <Compile Include="WorkstationClient.cs"/>
        <Compile Include="NetPackages.cs"/>
        <Compile Include="NetCompat.cs"/>
        <Compile Include="XUiInject.cs"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="ModInfo.xml"/>
        <None Include="web\**"/>
        <None Include="XUi\**"/>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>

    <!-- Deploy mod to game folder after build -->
    <Target Name="DeployMod" AfterTargets="Build">
        <PropertyGroup>
            <ModFolder>$(GamePath)\Mods\$(ModName)</ModFolder>
        </PropertyGroup>
        <MakeDir Directories="$(ModFolder)" Condition="!Exists('$(ModFolder)')"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)"/>
        <Copy SourceFiles="$(ProjectDir)ModInfo.xml" DestinationFolder="$(ModFolder)"/>
        <ItemGroup>
            <WebFiles Include="$(ProjectDir)web\**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(WebFiles)" DestinationFolder="$(ModFolder)\web\%(RecursiveDir)"/>
        <Copy SourceFiles="$(ProjectDir)XUi\windows.xml" DestinationFolder="$(ModFolder)\XUi"/>
        <!-- Older builds shipped the panel in Config/, which the server would send to every client -->
        <RemoveDir Directories="$(ModFolder)\Config"/>
        <Message Text="Deployed $(ModName) to $(ModFolder)" Importance="high"/>
    </Target>

</Project>
